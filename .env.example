# OpenClaw Office Backend Environment Variables

# Port for the backend server (default: 8844)
PORT=8844

# JWT signing secret (if not set, one is generated and persisted to disk)
# JWT_SECRET=your-secret-here

# OpenClaw Gateway WebSocket URL (default: ws://127.0.0.1:18789)
# OPENCLAW_GW=ws://127.0.0.1:18789

# Set to "production" to serve built frontend from backend
# NODE_ENV=production