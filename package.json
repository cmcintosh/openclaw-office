{
  "name": "openclaw-office",
  "version": "2.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite --host 0.0.0.0 --port 8843",
    "dev:backend": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 8843",
    "start": "NODE_ENV=production node server/index.js",
    "generate-sprites": "tsx scripts/generate-sprites.ts"
  },
  "dependencies": {
    "express": "^4.19.0",
    "helmet": "^7.1.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.62",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.10",
    "concurrently": "^8.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}